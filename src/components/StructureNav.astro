---
interface NavLink {
  href: string;
  label: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

interface Props {
  prev?: NavLink | null;
  next?: NavLink | null;
}

const { prev, next } = Astro.props;
---

<nav
  class="mt-16 grid border-t border-hairline sm:grid-cols-2"
  aria-label="Structure navigation"
>
  <div>
    {
      prev && (
        <a
          href={prev.href}
          class="meta inline-block py-4 transition-colors hover:text-accent"
        >
          ← {prev.label}
        </a>
      )
    }
  </div>

  <div class="flex flex-wrap items-center gap-x-6 sm:justify-end">
    {
      next?.secondaryHref && next?.secondaryLabel && (
        <a
          href={next.secondaryHref}
          class="meta inline-block py-4 transition-colors hover:text-accent"
        >
          {next.secondaryLabel} ↑
        </a>
      )
    }
    {
      next && (
        <a
          href={next.href}
          class="meta inline-block py-4 transition-colors hover:text-accent"
        >
          {next.label} →
        </a>
      )
    }
  </div>
</nav>
