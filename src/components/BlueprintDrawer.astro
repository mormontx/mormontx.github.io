---
interface Iteration {
  year: number;
  change: string;
}

interface Blueprint {
  constraints: string[];
  failurePoints: string[];
  iterations: Iteration[];
}

interface Props {
  blueprint: Blueprint;
  open?: boolean;
}

const { blueprint, open = true } = Astro.props;
---

<details open={open} class="group border-t border-b border-hairline">
  <summary
    class="blueprint-summary flex cursor-pointer list-none items-center gap-2.5 py-4 text-ink transition-colors hover:text-accent [&::-webkit-details-marker]:hidden"
  >
    <span class="meta text-ink transition-colors group-hover:text-accent">
      Blueprint / Constraints · Failure Points · Iterations
    </span>
    <span
      class="ms-auto shrink-0 font-mono text-meta uppercase text-accent"
      aria-hidden="true"
    >
      <span class="group-open:hidden">[EXPAND SPECS +]</span>
      <span class="hidden group-open:inline">[COLLAPSE SPECS ×]</span>
    </span>
  </summary>

  <div class="pb-6 pt-2 grid gap-8 sm:grid-cols-3">
    <div>
      <p class="meta">Constraints</p>
      <ol class="mt-3 list-decimal pl-5 font-serif text-base text-ink/85 space-y-1.5">
        {
          blueprint.constraints.map((constraint) => (
            <li>{constraint}</li>
          ))
        }
      </ol>
    </div>

    <div>
      <p class="meta">Failure Points</p>
      <ul class="mt-3 list-disc pl-5 font-serif text-base text-ink/85 space-y-1.5">
        {
          blueprint.failurePoints.map((point) => (
            <li>{point}</li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="meta">Iterations</p>
      <div class="mt-3">
        {
          blueprint.iterations.map((iteration) => (
            <div class="border-t border-hairline py-3">
              <p class="font-mono text-sm text-accent">{iteration.year}</p>
              <p class="font-serif text-base text-ink/85 mt-1">{iteration.change}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</details>
