---
interface Iteration {
  year: number;
  change: string;
}

interface Blueprint {
  constraints: string[];
  failurePoints: string[];
  iterations: Iteration[];
}

interface Props {
  blueprint: Blueprint;
}

const { blueprint } = Astro.props;
---

<!-- Open by default: the blueprint is the analytical half of each structure,
     not a footnote. It still folds away for readers who only want the story. -->
<details open class="group border-t border-b border-hairline">
  <summary
    class="flex cursor-pointer list-none items-baseline justify-between gap-4 py-5 [&::-webkit-details-marker]:hidden"
  >
    <span>
      <h2 class="font-display text-2xl text-ink">Blueprint</h2>
      <span class="meta mt-1 block">Constraints · Failure Points · Iterations</span>
    </span>
    <span
      class="font-mono text-lg text-ink transition-transform group-open:rotate-45 group-hover:text-accent"
      aria-hidden="true">+</span
    >
  </summary>

  <div class="pb-8 pt-2 grid gap-8 sm:grid-cols-3">
    <div>
      <p class="meta">Constraints</p>
      <ol class="mt-3 list-decimal pl-5 font-serif text-base text-ink/85 space-y-1.5">
        {
          blueprint.constraints.map((constraint) => (
            <li>{constraint}</li>
          ))
        }
      </ol>
    </div>

    <div>
      <p class="meta">Failure Points</p>
      <ul class="mt-3 list-disc pl-5 font-serif text-base text-ink/85 space-y-1.5">
        {
          blueprint.failurePoints.map((point) => (
            <li>{point}</li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="meta">Iterations</p>
      <div class="mt-3">
        {
          blueprint.iterations.map((iteration) => (
            <div class="border-t border-hairline py-3">
              <p class="font-mono text-sm text-accent">{iteration.year}</p>
              <p class="font-serif text-base text-ink/85 mt-1">{iteration.change}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</details>
