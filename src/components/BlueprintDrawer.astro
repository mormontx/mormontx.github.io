---
interface Iteration {
  year: number;
  change: string;
}

interface Blueprint {
  constraints: string[];
  failurePoints: string[];
  iterations: Iteration[];
}

interface Props {
  blueprint: Blueprint;
}

const { blueprint } = Astro.props;
---

<details class="group border-t border-b border-hairline">
  <summary
    class="flex cursor-pointer list-none items-center justify-between py-4 [&::-webkit-details-marker]:hidden"
  >
    <span class="meta">Blueprint / Constraints · Failure Points · Iterations</span>
    <span
      class="font-mono text-sm text-ink transition-transform group-open:rotate-45"
      aria-hidden="true">+</span
    >
  </summary>

  <div class="pb-6 grid gap-8 sm:grid-cols-3">
    <div>
      <p class="meta">Constraints</p>
      <ol class="mt-3 list-decimal pl-5 font-serif text-base text-ink/85 space-y-1.5">
        {
          blueprint.constraints.map((constraint) => (
            <li>{constraint}</li>
          ))
        }
      </ol>
    </div>

    <div>
      <p class="meta">Failure Points</p>
      <ul class="mt-3 list-disc pl-5 font-serif text-base text-ink/85 space-y-1.5">
        {
          blueprint.failurePoints.map((point) => (
            <li>{point}</li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="meta">Iterations</p>
      <div class="mt-3">
        {
          blueprint.iterations.map((iteration) => (
            <div class="border-t border-hairline py-3">
              <p class="font-mono text-sm text-accent">{iteration.year}</p>
              <p class="font-serif text-base text-ink/85 mt-1">{iteration.change}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</details>
