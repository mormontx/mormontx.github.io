---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const MONTHS = [
  'JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN',
  'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC',
];

const fmtDate = (d: Date) =>
  `${String(d.getUTCDate()).padStart(2, '0')} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;

const readingTime = (body: string) =>
  Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 220));

const notes = (await getCollection('notes'))
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const byYear = new Map<number, typeof notes>();
for (const note of notes) {
  const year = note.data.date.getUTCFullYear();
  const list = byYear.get(year) ?? [];
  list.push(note);
  byYear.set(year, list);
}
---

<BaseLayout title="Notes">
  <section class="shell py-16 sm:py-20">
    <p class="meta">Writings / Field Notes</p>
    <h1 class="font-display text-4xl sm:text-5xl text-ink mt-4">
      Notes &amp; Publications
    </h1>
    <p class="mt-4 max-w-2xl font-serif italic text-lg text-mute">
      Field notes, essays, and the working record behind the structures — the
      parts of the practice that never became a diagram.
    </p>

    <div class="mt-16">
      {
        Array.from(byYear.entries()).map(([year, list]) => (
          <section class="mt-12 first:mt-0">
            <div class="flex items-baseline justify-between border-b border-hairline pb-2">
              <p class="meta">{year}</p>
              <p class="meta">
                {String(list.length).padStart(2, '0')} {list.length === 1 ? 'Note' : 'Notes'}
              </p>
            </div>

            {
              list.map((note) => (
                <a
                  href={`/notes/${note.id}/`}
                  class="group grid gap-2 border-t border-hairline py-8 sm:grid-cols-[7rem_1fr_4rem] sm:items-baseline sm:gap-6"
                >
                  <div class="flex items-baseline gap-4 sm:block">
                    <span class="font-mono text-sm text-mute">{fmtDate(note.data.date)}</span>
                    <span class="meta">{note.data.kind}</span>
                  </div>

                  <div class="min-w-0">
                    <span
                      class="font-display text-2xl text-ink transition-colors group-hover:text-accent sm:text-3xl"
                    >
                      {note.data.title}
                    </span>
                    <span
                      class="mt-1 line-clamp-2 font-serif italic text-base text-mute"
                    >
                      {note.data.summary}
                    </span>
                  </div>

                  <span class="font-mono text-sm text-mute sm:text-right">
                    {readingTime(note.body ?? '')} MIN
                  </span>
                </a>
              ))
            }
          </section>
        ))
      }
    </div>

    <div class="mt-4 border-t border-hairline py-4">
      <p class="meta">{String(notes.length).padStart(2, '0')} Notes Archived</p>
    </div>
  </section>
</BaseLayout>
